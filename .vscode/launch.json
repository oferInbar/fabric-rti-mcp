{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Attach to Process Id",
            "type": "debugpy",
            "request": "attach",
            "processId": "${command:pickProcess}",
        },
        {
            "name": "Python Debugger: Debug server.py with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "defender_ah_mcp/server.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug: defender-ah-mcp-dev-zava-corp",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "defender_ah_mcp/server.py",
            "console": "integratedTerminal",
            "preLaunchTask": "pip-install-dev",
            "env": {
                "DEFENDER_GRAPH_TENANT_ID": "0527ecb7-06fb-4769-b324-fd4a3bb865eb",
                "DEFENDER_GRAPH_API_BASE_URL": "https://partnersgw.securitycenter.windows.com/api/mdgw/gaia/medeinaapi",
                "DEFENDER_GRAPH_TOKEN_SCOPE": "https://securitycenter.microsoft.com/mtp/.default",
                "DEFENDER_GRAPH_AUTH_PREFER_DEFAULT": "true",
                "AH_MODE": "true",
                "HUNTING_QUERY_FIELD_NAME": "queryText",
                "HUNTING_ENDPOINT": "/hunting/RunHuntingQuery",
                "HUNTING_SCHEMA_ENDPOINT": "/hunting/GetHuntingSchema",
                "HUNTING_SCHEMA_OUTPUT_FILE": "/tmp/hunting_schema.json"
            }
        },
        {
            "name": "Debug (HTTP, no auth): defender-ah-mcp-dev-zava-corp",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "defender_ah_mcp/server.py",
            "args": ["--http", "--host", "127.0.0.1", "--port", "8080"],
            "console": "integratedTerminal",
            "preLaunchTask": "pip-install-dev",
            "env": {
                "DEFENDER_AH_DISABLE_AUTH": "true",
                "DEFENDER_GRAPH_TENANT_ID": "0527ecb7-06fb-4769-b324-fd4a3bb865eb",
                "DEFENDER_GRAPH_API_BASE_URL": "https://partnersgw.securitycenter.windows.com/api/mdgw/gaia/medeinaapi",
                "DEFENDER_GRAPH_TOKEN_SCOPE": "https://securitycenter.microsoft.com/mtp/.default",
                "DEFENDER_GRAPH_AUTH_PREFER_DEFAULT": "true",
                "AH_MODE": "true",
                "HUNTING_QUERY_FIELD_NAME": "queryText",
                "HUNTING_ENDPOINT": "/hunting/RunHuntingQuery",
                "HUNTING_SCHEMA_ENDPOINT": "/hunting/GetHuntingSchema"
            }
        },
        {
            "name": "Debug: AWS Login Overview (Streamlit)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/Ignore/AWS login overview/app.py"
            ],
            "cwd": "${workspaceFolder}/Ignore/AWS login overview",
            "console": "integratedTerminal",
            "env": {
                "DEFENDER_GRAPH_TENANT_ID": "0527ecb7-06fb-4769-b324-fd4a3bb865eb",
                "DEFENDER_GRAPH_API_BASE_URL": "https://partnersgw.securitycenter.windows.com/api/mdgw/gaia/medeinaapi",
                "DEFENDER_GRAPH_TOKEN_SCOPE": "https://securitycenter.microsoft.com/mtp/.default",
                "DEFENDER_GRAPH_AUTH_PREFER_DEFAULT": "true",
                "AH_MODE": "true",
                "HUNTING_QUERY_FIELD_NAME": "queryText",
                "HUNTING_ENDPOINT": "/hunting/RunHuntingQuery",
                "HUNTING_SCHEMA_ENDPOINT": "/hunting/GetHuntingSchema"
            }
        },
        {
            "name": "Debug: AWS User Activity (Streamlit)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/Ignore/AWS User Activity/app/streamlit_app.py"
            ],
            "cwd": "${workspaceFolder}/Ignore/AWS User Activity",
            "console": "integratedTerminal",
            "env": {
                "DEFENDER_GRAPH_TENANT_ID": "0527ecb7-06fb-4769-b324-fd4a3bb865eb",
                "DEFENDER_GRAPH_API_BASE_URL": "https://partnersgw.securitycenter.windows.com/api/mdgw/gaia/medeinaapi",
                "DEFENDER_GRAPH_TOKEN_SCOPE": "https://securitycenter.microsoft.com/mtp/.default",
                "DEFENDER_GRAPH_AUTH_PREFER_DEFAULT": "true",
                "AH_MODE": "true",
                "HUNTING_QUERY_FIELD_NAME": "queryText",
                "HUNTING_ENDPOINT": "/hunting/RunHuntingQuery",
                "HUNTING_SCHEMA_ENDPOINT": "/hunting/GetHuntingSchema"
            }
        },
        {
            "name": "Debug: SAP NetWeaver Initial Access (Streamlit)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/dashboards/sap_netweaver_initial_access/app/streamlit_app.py"
            ],
            "cwd": "${workspaceFolder}/dashboards/sap_netweaver_initial_access",
            "console": "integratedTerminal",
            "env": {
                "DEFENDER_GRAPH_TENANT_ID": "0527ecb7-06fb-4769-b324-fd4a3bb865eb",
                "DEFENDER_GRAPH_API_BASE_URL": "https://partnersgw.securitycenter.windows.com/api/mdgw/gaia/medeinaapi",
                "DEFENDER_GRAPH_TOKEN_SCOPE": "https://securitycenter.microsoft.com/mtp/.default",
                "DEFENDER_GRAPH_AUTH_PREFER_DEFAULT": "true",
                "AH_MODE": "true",
                "HUNTING_QUERY_FIELD_NAME": "queryText",
                "HUNTING_ENDPOINT": "/hunting/RunHuntingQuery",
                "HUNTING_SCHEMA_ENDPOINT": "/hunting/GetHuntingSchema"
            }
        },
        // debug tests
        {
            "name": "Python Debugger: Test Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}"
            ],
            "console": "integratedTerminal"
        }
    ]
}