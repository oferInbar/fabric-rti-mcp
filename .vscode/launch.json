{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Attach to Process Id",
            "type": "debugpy",
            "request": "attach",
            "processId": "${command:pickProcess}",
        },
        {
            "name": "Python Debugger: Debug server.py with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "fabric_rti_mcp/server.py",
            "console": "integratedTerminal",
            "env": {
                "KUSTO_SERVICE_URI": "https://help.kusto.windows.net/"
            }
        },
        {
            "name": "Debug: fabric-rti-mcp-ah-dev-zava-corp",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "fabric_rti_mcp/server.py",
            "console": "integratedTerminal",
            "preLaunchTask": "pip-install-dev",
            "env": {
                "FABRIC_GRAPH_TENANT_ID": "0527ecb7-06fb-4769-b324-fd4a3bb865eb",
                "FABRIC_GRAPH_API_BASE_URL": "https://partnersgw.securitycenter.windows.com/api/mdgw/gaia/medeinaapi",
                "FABRIC_GRAPH_TOKEN_SCOPE": "https://securitycenter.microsoft.com/mtp/.default",
                "FABRIC_GRAPH_AUTH_PREFER_DEFAULT": "true",
                "AH_MODE": "true",
                "HUNTING_QUERY_FIELD_NAME": "queryText",
                "HUNTING_ENDPOINT": "/hunting/RunHuntingQuery",
                "HUNTING_SCHEMA_ENDPOINT": "/hunting/GetHuntingSchema",
                "HUNTING_SCHEMA_OUTPUT_FILE": "/tmp/hunting_schema.json"
            }
        },
        {
            "name": "Debug (HTTP, no auth): fabric-rti-mcp-ah-dev-zava-corp",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "fabric_rti_mcp/server.py",
            "args": ["--http", "--host", "127.0.0.1", "--port", "8080"],
            "console": "integratedTerminal",
            "preLaunchTask": "pip-install-dev",
            "env": {
                "FABRIC_RTI_DISABLE_AUTH": "true",
                "FABRIC_GRAPH_TENANT_ID": "0527ecb7-06fb-4769-b324-fd4a3bb865eb",
                "FABRIC_GRAPH_API_BASE_URL": "https://partnersgw.securitycenter.windows.com/api/mdgw/gaia/medeinaapi",
                "FABRIC_GRAPH_TOKEN_SCOPE": "https://securitycenter.microsoft.com/mtp/.default",
                "FABRIC_GRAPH_AUTH_PREFER_DEFAULT": "true",
                "AH_MODE": "true",
                "HUNTING_QUERY_FIELD_NAME": "queryText",
                "HUNTING_ENDPOINT": "/hunting/RunHuntingQuery",
                "HUNTING_SCHEMA_ENDPOINT": "/hunting/GetHuntingSchema"
            }
        },
        // debug tests
        {
            "name": "Python Debugger: Test Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}"
            ],
            "console": "integratedTerminal",
            "env": {
                "KUSTO_SERVICE_URI": "https://help.kusto.windows.net/"
            }
        }
    ]
}