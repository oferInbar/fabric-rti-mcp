# =============================================================================
# Defender Advanced Hunting MCP — environment template
# =============================================================================
# Copy this file to .env (which is gitignored) and fill in the secrets:
#   cp .env.example .env
#
# Then start the server with: ./scripts/run-docker.sh
# =============================================================================

# --- Mode --------------------------------------------------------------------
# AdvancedHunting (core only) | VibeHunting (core + enrichment)
AH_MODE=VibeHunting

# --- Microsoft Graph authentication ------------------------------------------
# Pick ONE of the following approaches.
#
# A) Bearer pass-through (recommended for local dev — mirrors production)
#    Leave CLIENT_ID / CLIENT_SECRET empty and run:
#        ./scripts/run-docker.sh --local-token
#    The script will use `az account get-access-token` on the host and inject
#    it as DEFENDER_GRAPH_ACCESS_TOKEN. The container does NOT acquire its
#    own token — exactly like production behind a gateway.
#
# B) App-only client credentials (no host az session needed)
#    Fill in all three values below and run `./scripts/run-docker.sh`.
DEFENDER_GRAPH_TENANT_ID=
DEFENDER_GRAPH_CLIENT_ID=
DEFENDER_GRAPH_CLIENT_SECRET=

# Optional: override the Graph base URL / token scope.
# For ZAVA-CORP / Medeina partner gateway, use the values below.
# DEFENDER_GRAPH_API_BASE_URL=https://partnersgw.securitycenter.windows.com/api/mdgw/gaia/medeinaapi
# DEFENDER_GRAPH_TOKEN_SCOPE=https://securitycenter.microsoft.com/mtp/.default

# --- Hunting endpoint overrides ----------------------------------------------
# Default targets the Microsoft Graph runHuntingQuery API. Override for the
# Medeina / partner gateway.
# HUNTING_ENDPOINT=/hunting/RunHuntingQuery
# HUNTING_SCHEMA_ENDPOINT=/hunting/GetHuntingSchema
# HUNTING_QUERY_FIELD_NAME=queryText

# --- HTTP transport (Docker defaults) ----------------------------------------
DEFENDER_AH_TRANSPORT=http
DEFENDER_AH_HTTP_HOST=0.0.0.0
DEFENDER_AH_HTTP_PORT=3000
DEFENDER_AH_HTTP_PATH=/mcp

# For LOCAL DOCKER ONLY: skip the bearer-token auth middleware so MCP clients
# can hit http://localhost:3000/mcp without sending an Authorization header.
# Leave unset (or false) in any shared / deployed environment.
DEFENDER_AH_DISABLE_AUTH=true
